table dim_prod

	column prod_id
		dataType: int64
		summarizeBy: sum
		sourceColumn: prod_id

	column prod_nm
		dataType: string
		summarizeBy: none
		sourceColumn: prod_nm

	column cat
		dataType: string
		summarizeBy: none
		sourceColumn: cat

	column subcat
		dataType: string
		summarizeBy: none
		sourceColumn: subcat

	partition dim_prod = m
		mode: import
		source =
				let
					Source = #table(
						type table [prod_id = Int64.Type, prod_nm = text, cat = text, subcat = text],
						{
							{201, "Mountain Bike 200", "Bikes", "Mountain"},
							{202, "Water Bottle", "Accessories", "Hydration"},
							{203, "Road Helmet", "Accessories", "Safety"},
							{204, "Cycling Gloves", "Clothing", "Gloves"}
						}
					)
				in
					Source
