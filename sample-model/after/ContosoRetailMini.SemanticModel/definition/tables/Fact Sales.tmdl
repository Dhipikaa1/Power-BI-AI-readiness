/// Sales transactions at order-line grain. One row per product sold on an order. Primary fact table for revenue analysis.
table 'Fact Sales'

	/// Total gross sales in USD across all transactions. Primary revenue KPI.
	measure 'Total Sales' = SUM('Fact Sales'[Sales Amount])
		formatString: $#,##0.00

		annotation Synonyms = Revenue, Total Revenue, Sales

	/// Total number of units sold across all transactions.
	measure 'Total Quantity' = SUM('Fact Sales'[Quantity])
		formatString: #,##0

		annotation Synonyms = Units Sold, Total Units, Volume

	/// Average discount rate across order lines, expressed as a percentage.
	measure 'Average Discount %' = AVERAGE('Fact Sales'[Discount %])
		formatString: 0.0%

		annotation Synonyms = Avg Discount, Average Markdown

	/// Year-to-date total sales in USD, based on the Date table.
	measure 'Sales YTD' = TOTALYTD([Total Sales], 'Dim Date'[Date])
		formatString: $#,##0.00

		annotation Synonyms = Year to Date Sales, YTD Revenue

	column 'Sale Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sls_id

	column 'Customer Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: cust_id

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: prod_id

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: dt_ky

	/// Gross sales amount in USD for the order line, before tax. Use for revenue and top-line reporting.
	column 'Sales Amount'
		dataType: double
		formatString: $#,##0.00
		summarizeBy: sum
		sourceColumn: txn_amt

		annotation Synonyms = Revenue, Sales, Turnover, Amount

	/// Number of units sold on the order line.
	column Quantity
		dataType: int64
		summarizeBy: sum
		sourceColumn: qty

		annotation Synonyms = Units, Units Sold, Volume

	/// Discount applied to the order line, as a fraction between 0 and 1 (e.g. 0.10 = 10%).
	column 'Discount %'
		dataType: double
		formatString: 0.0%
		summarizeBy: sum
		sourceColumn: disc_pct

		annotation Synonyms = Discount, Markdown

	partition fct_sls = m
		mode: import
		source =
				let
					Source = #table(
						type table [sls_id = Int64.Type, cust_id = Int64.Type, prod_id = Int64.Type, dt_ky = Int64.Type, txn_amt = number, qty = Int64.Type, disc_pct = number],
						{
							{1, 101, 201, 20240101, 1200.00, 3, 0.05},
							{2, 102, 202, 20240102, 340.50, 1, 0.00},
							{3, 101, 203, 20240115, 780.00, 2, 0.10},
							{4, 103, 201, 20240201, 1560.00, 4, 0.05},
							{5, 104, 204, 20240210, 220.00, 1, 0.00},
							{6, 102, 202, 20240305, 681.00, 2, 0.00},
							{7, 103, 203, 20240312, 390.00, 1, 0.10},
							{8, 104, 201, 20240320, 3120.00, 8, 0.15}
						}
					)
				in
					Source

	annotation Synonyms = Orders, Transactions, Sales Lines

